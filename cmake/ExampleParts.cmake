# One manifest drives the installed examples and development runtime copies.
set(BENDING_EXAMPLE_SOURCE_DIR "${PROJECT_SOURCE_DIR}/examples")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/cmake/example-parts.json")
file(READ "${PROJECT_SOURCE_DIR}/cmake/example-parts.json" bending_examples_json)
string(JSON bending_examples_format GET "${bending_examples_json}" format)
string(JSON bending_examples_version GET "${bending_examples_json}" version)
string(JSON bending_example_count LENGTH "${bending_examples_json}" parts)
if(NOT bending_examples_format STREQUAL "bending-example-parts" OR
   NOT bending_examples_version EQUAL 1 OR bending_example_count LESS 1 OR bending_example_count GREATER 16)
    message(FATAL_ERROR "Invalid starter example manifest")
endif()
set(BENDING_STARTER_EXAMPLE_FILES)
math(EXPR bending_last_example "${bending_example_count} - 1")
foreach(index RANGE ${bending_last_example})
    string(JSON name GET "${bending_examples_json}" parts ${index} file)
    if(NOT name MATCHES "^[a-z0-9][a-z0-9-]*\\.(step|stp)$" OR NOT EXISTS "${BENDING_EXAMPLE_SOURCE_DIR}/${name}")
        message(FATAL_ERROR "Missing/invalid starter STEP: ${name}")
    endif()
    list(APPEND BENDING_STARTER_EXAMPLE_FILES "${BENDING_EXAMPLE_SOURCE_DIR}/${name}")
endforeach()
if(BUILD_TESTING)
    set(BENDING_TEST_EXAMPLE_DIR "${PROJECT_BINARY_DIR}/test-step-data")
    file(MAKE_DIRECTORY "${BENDING_TEST_EXAMPLE_DIR}")
    file(GLOB bending_step_fixtures CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/tests/data/step/*.step" "${PROJECT_SOURCE_DIR}/tests/data/step/*.stp")
    set(bending_test_names)
    foreach(source IN LISTS BENDING_STARTER_EXAMPLE_FILES bending_step_fixtures)
        get_filename_component(name "${source}" NAME)
        if(name IN_LIST bending_test_names)
            message(FATAL_ERROR "Duplicate STEP fixture name: ${name}")
        endif()
        list(APPEND bending_test_names "${name}")
        configure_file("${source}" "${BENDING_TEST_EXAMPLE_DIR}/${name}" COPYONLY)
    endforeach()
endif()
