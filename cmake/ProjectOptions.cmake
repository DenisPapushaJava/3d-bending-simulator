add_library(bending_options INTERFACE)
if(MSVC)
    target_compile_options(bending_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:/W4;/permissive-;/utf-8>")
    if(BENDING_WARNINGS_AS_ERRORS)
        target_compile_options(bending_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:/WX>")
    endif()
else()
    target_compile_options(bending_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:-Wall;-Wextra;-Wpedantic>")
    if(BENDING_WARNINGS_AS_ERRORS)
        target_compile_options(bending_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:-Werror>")
    endif()
endif()
